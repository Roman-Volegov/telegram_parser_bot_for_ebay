# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Опционально: ограничить доступ списком Telegram user id через запятую
# ALLOWED_USER_IDS=123456789,987654321

# Интервал опроса новых лотов (секунды)
WATCH_POLL_INTERVAL_SECONDS=120

# eBay Browse API (опционально; без ключей используется публичный поиск)
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_MARKETPLACE_ID=EBAY_US

# Путь к SQLite БД
DATABASE_PATH=data/bot.db

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
