TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Публичный URL сервиса (для eBay Marketplace Account Deletion)
# Для Mini App нужен HTTPS. На VPS: https://<IP>.sslip.io:8443 (Caddy)
PUBLIC_BASE_URL=https://78.17.135.134.sslip.io:8443
MINIAPP_DOMAIN=78.17.135.134.sslip.io

POLL_INTERVAL_SEC=300
SEEN_ITEMS_TTL_DAYS=90
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO

# Порт FastAPI внутри контейнера (снаружи в compose проброшен 18080)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Постоянный Chromium-профиль сохраняет ручную проверку DataDome.
# Не менее 32 случайных символов: python -c "import secrets; print(secrets.token_urlsafe(32))"
ETSY_NOVNC_TOKEN=
ETSY_NOVNC_TTL_SEC=600
ETSY_BROWSER_HEADLESS=false
ETSY_BROWSER_PROFILE_DIR=/app/data/etsy-browser-profile

# Необязательный proxy, если ручная проверка с IP VPS не проходит:
# HTTP_PROXY=http://user:pass@host:port

# Etsy: постоянный профиль Playwright. Open API ключ опционален (Mini App).
