# Caddy обслуживает Mini App на стандартных HTTP/HTTPS-портах.
http://{$XUI_ACME_HOST} {
	handle /.well-known/acme-challenge/* {
		root * /srv/acme-challenge
		file_server
	}
	respond 404
}

http://{$MINIAPP_DOMAIN} {
	redir https://{$MINIAPP_DOMAIN}{uri} permanent
}

https://{$MINIAPP_DOMAIN} {
	encode gzip

	handle_path /{$ETSY_NOVNC_TOKEN}/* {
		forward_auth bot:8080 {
			uri /internal/etsy-vnc-auth
		}
		reverse_proxy bot:6080
	}

	handle {
		header {
			Referrer-Policy "same-origin"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		reverse_proxy bot:8080
	}
}
